---
import { FAQS } from '../data/fleetData';
---

<section class="w-full bg-[#0e0e0e] border-b border-[#1f1f1f] scroll-mt-12" id="security">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-5 lg:px-6 py-10 sm:py-14 lg:py-16">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 pb-4 border-b border-[#1f1f1f]">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <span class="w-2 h-2 bg-[#ff5a00] inline-block shadow-[0_0_6px_#ff5a00]"></span>
          <span class="font-mono text-[10px] uppercase tracking-widest text-[#ff5a00]">[MODULE_05 // GOOD TO KNOW]</span>
        </div>
        <h2 class="font-headline text-xl sm:text-2xl lg:text-3xl font-extrabold uppercase tracking-tight text-[#ffffff] m-0">
          FAQS &amp; RENTAL POLICIES
        </h2>
      </div>
      <div class="font-mono text-[10px] sm:text-xs text-[#888] uppercase tracking-wider mt-4 md:mt-0">
        DRIVER REQUIREMENTS // INSURANCE // CANCELLATION
      </div>
    </div>

    {/* Monospace Technical Accordions */}
    <div class="border border-[#1f1f1f] divide-y divide-[#1f1f1f] overflow-hidden">
      {FAQS.map((faq, i) => {
        const isOpen = i === 0;
        return (
          <div class="group bg-[#0e0e0e] hover:bg-[#121212] transition-colors" data-faq-item={faq.id}>
            <button
              type="button"
              data-faq-toggle
              aria-expanded={isOpen}
              aria-controls={`faq-answer-${faq.id}`}
              class="w-full p-4 sm:p-6 flex items-center justify-between text-left cursor-pointer list-none select-none"
            >
              <div class="flex items-center gap-3 sm:gap-4 pr-4">
                <span class="font-mono text-xs sm:text-sm text-[#ff5a00] font-bold shrink-0">{faq.code}</span>
                <h3 class="font-headline text-xs sm:text-sm md:text-base font-bold uppercase tracking-wide text-[#ffffff]">{faq.question}</h3>
              </div>
              <span data-faq-icon class={`font-mono text-sm sm:text-base text-[#ff5a00] transition-transform duration-200 shrink-0 ${isOpen ? 'rotate-45' : 'rotate-0'}`}>
                ✛
              </span>
            </button>

            <div id={`faq-answer-${faq.id}`} data-faq-answer class={`px-4 sm:px-6 pb-6 pt-1 font-editorial text-xs sm:text-sm text-[#b0b0b0] border-t border-[#1f1f1f]/50 ${isOpen ? '' : 'hidden'}`}>
              <p class="pt-4 leading-relaxed">{faq.answer}</p>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<script>
  const items = Array.from(document.querySelectorAll('[data-faq-item]'));
  items.forEach((item) => {
    const toggle = item.querySelector('[data-faq-toggle]');
    const answer = item.querySelector('[data-faq-answer]');
    const icon = item.querySelector('[data-faq-icon]');
    toggle?.addEventListener('click', () => {
      const willOpen = answer?.classList.contains('hidden') ?? false;
      if (willOpen) {
        items.forEach((other) => {
          other.querySelector('[data-faq-answer]')?.classList.add('hidden');
          other.querySelector('[data-faq-icon]')?.classList.remove('rotate-45');
          other.querySelector('[data-faq-toggle]')?.setAttribute('aria-expanded', 'false');
        });
      }
      answer?.classList.toggle('hidden', !willOpen);
      icon?.classList.toggle('rotate-45', willOpen);
      toggle?.setAttribute('aria-expanded', String(willOpen));
    });
  });
</script>