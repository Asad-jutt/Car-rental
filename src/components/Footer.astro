<script>
  const form = document.querySelector<HTMLFormElement>('[data-subscribe]');
  const input = document.querySelector<HTMLInputElement>('[data-cipher-input]');
  const button = document.querySelector<HTMLButtonElement>('[data-subscribe-btn]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!input || !input.value.trim()) return;
    if (button) button.textContent = 'SUBSCRIBED ✓';
    setTimeout(() => {
      if (input) input.value = '';
      if (button) button.textContent = 'SUBSCRIBE';
    }, 3000);
  });
</script>