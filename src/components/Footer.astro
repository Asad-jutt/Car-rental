---
import { createElement } from "react";
import { Footer, Twitter, Linkedin, Github, Mail } from "./ui/modem-animated-footer";

const socialLinks = [
  { icon: createElement(Twitter, { className: "w-6 h-6" }), href: "https://twitter.com", label: "Twitter" },
  { icon: createElement(Linkedin, { className: "w-6 h-6" }), href: "https://linkedin.com", label: "LinkedIn" },
  { icon: createElement(Github, { className: "w-6 h-6" }), href: "https://github.com", label: "GitHub" },
  { icon: createElement(Mail, { className: "w-6 h-6" }), href: "mailto:hello@kineticcars.com", label: "Email" },
];
---

<Footer
  brandName="KINETIC"
  brandDescription="Premium car rental with a modern, transparent approach. EVs, coupes, and family SUVs at flat daily rates with insurance and 24/7 support included."
  socialLinks={socialLinks}
  navLinks={[
    { label: "The Fleet", href: "/fleet" },
    { label: "Rates & Tiers", href: "/#tiers" },
    { label: "How It Works", href: "/#protocol" },
    { label: "Book Now", href: "/booking" },
  ]}
/>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-scroll-to-top]").forEach((button) => {
    button.addEventListener("click", () => {
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      window.scrollTo({ top: 0, left: 0, behavior: reduceMotion ? "auto" : "smooth" });
    });
  });
</script>