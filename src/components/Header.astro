---
import { BRAND_LOGO } from '../data/fleetData';
---

<header class="fixed top-0 left-0 right-0 z-50 select-none bg-[#0e0e0e]/80 supports-[backdrop-filter]:bg-[#0e0e0e]/45 backdrop-blur-xl backdrop-saturate-150 border-b border-white/10 shadow-[0_8px_32px_rgba(0,0,0,0.45)]">
  <div class="h-12 w-full max-w-[1200px] mx-auto px-2 sm:px-3 lg:px-4 flex items-center justify-between gap-3">
    {/* Left: Brand Identity */}
    <div class="flex items-center gap-2 sm:gap-3 shrink-0 min-w-0">
      <a href="/" class="flex items-center gap-2 sm:gap-3 group min-w-0">
        <img
          alt="KINETIC Brand Mark"
          fetchpriority="high"
          decoding="async"
          class="h-6 sm:h-7 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
          src={BRAND_LOGO}
        />
        <span class="font-headline text-lg sm:text-xl xl:text-2xl font-black uppercase tracking-tight text-[#e2e2e2]">
          KINETIC
        </span>
      </a>

      <div class="h-3 w-px bg-[#1f1f1f] hidden sm:block"></div>
      <span class="hidden lg:inline-block border border-[#1f1f1f] bg-[#1b1b1b] px-1.5 py-px font-mono text-[9px] uppercase tracking-wider text-[#929292]">
        [CAR RENTAL // NYC]
      </span>
    </div>

{/* Center: Navigation */}
    <nav class="hidden xl:flex items-center h-full" aria-label="Primary">
      <a
        href="/"
        data-nav="hero"
        aria-current="false"
        class="h-full flex items-center px-2 font-mono text-[9px] uppercase tracking-wider transition-colors border-b-2 border-transparent text-[#a0a0a0] hover:text-[#e2e2e2]"
      >
        STAGE 01 // HOME
      </a>
      <a
        href="/#inventory"
        data-nav="inventory"
        aria-current="false"
        class="h-full flex items-center px-2 font-mono text-[9px] uppercase tracking-wider transition-colors border-b-2 border-transparent text-[#a0a0a0] hover:text-[#e2e2e2]"
      >
        STAGE 02 // OUR FLEET
      </a>
      <a
        href="/#protocol"
        data-nav="protocol"
        aria-current="false"
        class="h-full flex items-center px-2 font-mono text-[9px] uppercase tracking-wider transition-colors border-b-2 border-transparent text-[#a0a0a0] hover:text-[#e2e2e2]"
      >
        STAGE 03 // HOW IT WORKS
      </a>
      <a
        href="/#tiers"
        data-nav="tiers"
        aria-current="false"
        class="h-full flex items-center px-2 font-mono text-[9px] uppercase tracking-wider transition-colors border-b-2 border-transparent text-[#a0a0a0] hover:text-[#e2e2e2]"
      >
        STAGE 04 // PRICING
      </a>
      <a
        href="/#sales-team"
        data-nav="sales-team"
        aria-current="false"
        class="h-full flex items-center px-2 font-mono text-[9px] uppercase tracking-wider transition-colors border-b-2 border-transparent text-[#a0a0a0] hover:text-[#e2e2e2]"
      >
        STAGE 05 // SALES TEAM
      </a>
      <a
        href="/booking"
        class="h-full flex items-center px-2 font-mono text-[9px] uppercase tracking-wider transition-colors border-b-2 border-transparent text-[#ff5a00] hover:text-[#e2e2e2]"
      >
        STAGE 06 // BOOK NOW
      </a>
    </nav>

    {/* Right: Status Chips + User Action */}
    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      {/* Active Telemetry Chip */}
      <div class="hidden sm:flex xl:hidden items-center gap-1.5 border border-[#1f1f1f] bg-[#1b1b1b] px-1.5 py-0.5 font-mono text-[9px] text-[#e2e2e2]">
        <span class="w-1.5 h-1.5 bg-[#ff5a00] inline-block shadow-[0_0_6px_#ff5a00] animate-pulse"></span>
        <span class="tracking-wide">[OPEN 24/7]</span>
      </div>

      {/* Global Region Indicator */}
      <div class="hidden lg:flex xl:hidden items-center border border-[#1f1f1f] bg-[#1b1b1b] px-1.5 py-0.5 font-mono text-[9px] text-[#929292]">
        <span class="text-[#a0a0a0]">[SUPPORT:</span>
        <span class="text-[#e2e2e2] ml-1">1-800-KINETIC]</span>
      </div>

      {/* Direct Dispatch Quick Button */}
      <a
        href="/booking"
        class="h-7 px-2.5 sm:px-3 bg-[#ff5a00] hover:bg-white text-black font-mono text-[9px] sm:text-[10px] font-bold uppercase tracking-wider flex items-center justify-center transition-colors whitespace-nowrap"
        aria-label="Go to booking page"
      >
        BOOKING
      </a>

      {/* Mobile Menu Button */}
      <button
        type="button"
        data-mobile-toggle
        aria-label="Toggle navigation menu"
        aria-controls="mobile-drawer"
        aria-expanded="false"
        class="xl:hidden w-7 h-7 border border-[#1f1f1f] bg-[#1b1b1b] flex items-center justify-center text-[#e2e2e2]"
      >
        <svg
          data-mobile-icon
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          class="w-4 h-4"
          aria-hidden="true"
        >
          <path data-icon-open d="M4 7h16M4 12h16M4 17h16" />
          <path data-icon-close d="M6 6l12 12M18 6L6 18" class="hidden" />
        </svg>
      </button>
    </div>
  </div>

  {/* Mobile Drawer */}
  <nav data-mobile-drawer aria-label="Mobile navigation" class="hidden xl:hidden bg-[#111]/80 backdrop-blur-xl backdrop-saturate-150 border-b border-white/10 p-4 font-mono text-xs space-y-2">
    <a href="/" data-mobile-close class="block py-2 px-3 border border-[#222] bg-[#161616] text-[#e2e2e2] hover:border-[#ff5a00]">
      STAGE 01 // HOME
    </a>
    <a href="/#inventory" data-mobile-close class="block py-2 px-3 border border-[#222] bg-[#161616] text-[#e2e2e2] hover:border-[#ff5a00]">
      STAGE 02 // OUR FLEET
    </a>
    <a href="/#protocol" data-mobile-close class="block py-2 px-3 border border-[#222] bg-[#161616] text-[#e2e2e2] hover:border-[#ff5a00]">
      STAGE 03 // HOW IT WORKS
    </a>
    <a href="/#tiers" data-mobile-close class="block py-2 px-3 border border-[#222] bg-[#161616] text-[#e2e2e2] hover:border-[#ff5a00]">
      STAGE 04 // PRICING
    </a>
    <a href="/#sales-team" data-mobile-close class="block py-2 px-3 border border-[#222] bg-[#161616] text-[#e2e2e2] hover:border-[#ff5a00]">
      STAGE 05 // SALES TEAM
    </a>
    <a href="/booking" data-mobile-close class="block py-2 px-3 border border-[#ff5a00] bg-[#ff5a00]/10 text-[#ff5a00] hover:border-[#ff5a00]">
      STAGE 06 // BOOK NOW
    </a>
  </nav>
</header>

<style is:global>
  .nav-active {
    color: #e2e2e2 !important;
    border-color: #ff5a00 !important;
    background-color: #1b1b1b !important;
  }
</style>

<script>
  // Mobile drawer
  const mobileToggle = document.querySelector('[data-mobile-toggle]');
  const mobileDrawer = document.querySelector('[data-mobile-drawer]');
  const iconOpen = document.querySelector('[data-icon-open]');
  const iconClose = document.querySelector('[data-icon-close]');
  const setDrawer = (open: boolean) => {
    mobileDrawer?.classList.toggle('hidden', !open);
    mobileToggle?.setAttribute('aria-expanded', String(open));
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
  };
  mobileToggle?.addEventListener('click', () => {
    setDrawer(!!mobileDrawer && mobileDrawer.classList.contains('hidden'));
  });
  document.querySelectorAll('[data-mobile-close]').forEach((link) =>
    link.addEventListener('click', () => setDrawer(false)),
  );

  // Active section tracking.
  //
  // This used to run on every scroll event and re-measure all five sections
  // inside the handler, which forces a synchronous layout on every scroll
  // frame. Measurements are now cached, the work is coalesced into one
  // animation frame, and the nav links are only touched when the active
  // section actually changes.
  const navLinks = Array.from(document.querySelectorAll('[data-nav]'));
  const sectionIds = ['hero', 'inventory', 'protocol', 'tiers', 'sales-team'];
  const sections = sectionIds
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  let bounds: { top: number; bottom: number }[] = [];
  let active = '';
  let pending = 0;
  let stale = true;

  const measure = () => {
    const scrollY = window.scrollY;
    bounds = sections.map((el) => {
      const top = el.getBoundingClientRect().top + scrollY;
      return { top, bottom: top + el.offsetHeight };
    });
    stale = false;
  };

  const updateNav = () => {
    pending = 0;
    if (stale) measure();

    const pos = window.scrollY + 200;
    let current = sectionIds[0] ?? 'hero';
    for (let i = 0; i < bounds.length; i += 1) {
      if (pos >= bounds[i].top && pos < bounds[i].bottom) {
        current = sections[i].id;
        break;
      }
    }
    if (current === active) return;
    active = current;
    for (const link of navLinks) {
      const isActive = link.getAttribute('data-nav') === active;
      link.classList.toggle('nav-active', isActive);
      link.setAttribute('aria-current', isActive ? 'true' : 'false');
    }
  };

  // Coalesce a burst of scroll events into a single pass per frame.
  const onScroll = () => {
    if (pending) return;
    pending = requestAnimationFrame(updateNav);
  };

  // A cached offset is only valid while the sections keep their heights, and
  // they do not: lazy images resolve, webfonts swap, and deferred-paint
  // sections replace their intrinsic-size estimate with the real thing once they
  // are rendered. Watching the sections themselves keeps the cache honest
  // without putting a layout read back on the scroll path.
  const sectionObserver = new ResizeObserver(() => {
    stale = true;
    onScroll();
  });
  for (const section of sections) sectionObserver.observe(section);

  const invalidate = () => {
    stale = true;
    onScroll();
  };
  window.addEventListener('resize', invalidate, { passive: true });
  window.addEventListener('scroll', onScroll, { passive: true });
  // Late-loading imagery changes section heights after first paint.
  window.addEventListener('load', invalidate);
  document.fonts?.ready.then(invalidate);
</script>