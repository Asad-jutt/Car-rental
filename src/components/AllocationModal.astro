---
import { HUBS, VEHICLES } from '../data/fleetData';
---

<div
  data-modal
  role="dialog"
  aria-modal="true"
  aria-label="Make a booking"
  aria-describedby="booking-summary"
  class="hidden fixed inset-0 z-50 bg-[#0e0e0e]/95 backdrop-blur-md items-center justify-center p-3 sm:p-6 overflow-y-auto"
>
  <div class="w-full max-w-5xl bg-[#141414] border border-[#262626] overflow-hidden p-4 sm:p-8 flex flex-col justify-between my-auto relative shadow-2xl">
    {/* Modal Top Bar */}
    <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-[#222]">
      <div class="flex items-center gap-3 min-w-0">
        <span class="w-3 h-3 bg-[#ff5a00] shadow-[0_0_8px_#ff5a00] shrink-0"></span>
        <span class="font-mono text-xs sm:text-sm text-[#ffffff] font-bold uppercase tracking-widest">
          [KINETIC CAR RENTAL // MAKE A BOOKING]
        </span>
      </div>
      <button
        type="button"
        data-modal-close
        class="px-3 py-1 bg-[#222] hover:bg-[#ff5a00] text-[#e2e2e2] hover:text-black font-mono text-xs uppercase tracking-wider transition-colors border border-[#333]"
      >
        [CLOSE ✕]
      </button>
    </div>

    {/* Modal Center Matrix Selectors */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-0 my-6 overflow-hidden border border-[#222] divide-y md:divide-y-0 md:divide-x divide-[#222]">
      {/* Hub Select */}
      <div class="p-4 sm:p-6 bg-[#0e0e0e] flex flex-col gap-4">
        <span class="font-mono text-xs text-[#ff5a00] uppercase tracking-wider font-bold">01 // SELECT PICKUP LOCATION</span>
        <div class="flex flex-col gap-1.5">
          {HUBS.map((hub) => (
            <div
              data-hub-option={hub.id}
              data-hub-latency={hub.latency}
              role="button"
              tabindex="0"
              aria-label={`Pick up location: ${hub.name}`}
              class="flex items-center justify-between p-2.5 cursor-pointer border transition-colors bg-[#141414] border-transparent hover:border-[#333]"
            >
              <div class="flex flex-col">
                <span class="font-mono text-xs text-[#ffffff]">{hub.name}</span>
                <span class="font-mono text-[9px] text-[#777]">PICKUP IN: {hub.latency}</span>
              </div>
              <span data-hub-dot class="w-2.5 h-2.5 bg-[#333]"></span>
            </div>
          ))}
        </div>
      </div>

      {/* Vehicle Select */}
      <div class="p-4 sm:p-6 bg-[#0e0e0e] flex flex-col gap-4">
        <span class="font-mono text-xs text-[#ff5a00] uppercase tracking-wider font-bold">02 // SELECT VEHICLE</span>
        <div class="flex flex-col gap-1.5">
          {VEHICLES.map((v) => (
            <div
              data-vehicle-option={v.id}
              data-vehicle-price={v.pricePer24h}
              role="button"
              tabindex="0"
              aria-label={`Select vehicle: ${v.name}`}
              class="flex items-center justify-between p-2.5 cursor-pointer border transition-colors bg-[#141414] border-transparent hover:border-[#333]"
            >
              <div class="flex flex-col">
                <span class="font-mono text-xs text-[#ffffff] font-bold">{v.name}</span>
                <span class="font-mono text-[9px] text-[#999]">{v.power} HP • {v.zeroToSixty}S • {v.drive}</span>
              </div>
              <span data-vehicle-dot class="w-2.5 h-2.5 bg-[#333]"></span>
            </div>
          ))}
        </div>

        {/* Duration Slider */}
        <div class="pt-2 border-t border-[#222]">
          <div class="flex justify-between font-mono text-[10px] text-[#888] mb-1">
            <span>RENTAL DURATION:</span>
            <span data-duration-label class="text-[#ff5a00] font-bold">3 DAYS</span>
          </div>
          <input
            type="range"
            min="1"
            max="14"
            value="3"
            data-duration
            aria-label="Rental duration in days"
            class="w-full accent-[#ff5a00] bg-[#222] h-1.5 cursor-pointer"
          />
        </div>
      </div>

      {/* Dispatch Spec */}
      <div id="booking-summary" class="p-4 sm:p-6 bg-[#0e0e0e] flex flex-col justify-between">
        <div>
          <span class="font-mono text-xs text-[#ff5a00] uppercase tracking-wider font-bold">03 // BOOKING SUMMARY</span>
          <div class="mt-4 space-y-1.5 font-mono text-[11px] text-[#888]">
            <div class="flex justify-between gap-2 flex-wrap py-1.5 bg-[#141414] px-2.5 border border-[#222]">
              <span>PICKUP AT BRANCH:</span>
              <span data-latency class="text-[#ffffff] font-bold">IMMEDIATE (5 MIN)</span>
            </div>
            <div class="flex justify-between gap-2 flex-wrap py-1.5 bg-[#141414] px-2.5 border border-[#222]">
              <span>CHECK-IN DOCS:</span>
              <span class="text-[#ffffff]">LICENSE + ID CARD</span>
            </div>
            <div class="flex justify-between gap-2 flex-wrap py-1.5 bg-[#141414] px-2.5 border border-[#222]">
              <span>INCLUDES:</span>
              <span class="text-[#ff5a00]">BASIC INSURANCE + ROADSIDE</span>
            </div>
            <div class="flex justify-between gap-2 flex-wrap py-1.5 bg-[#141414] px-2.5 border border-[#ff5a00]/40 mt-2">
              <span class="text-[#e2e2e2] font-bold">ESTIMATED TOTAL:</span>
              <span data-estimate class="text-[#ff5a00] font-extrabold text-xs sm:text-sm">$597 TOTAL</span>
            </div>
          </div>
        </div>

        <div class="mt-6">
          <div data-dispatch-success role="status" aria-live="polite" class="hidden p-3 bg-[#004d20] border border-[#00a846] text-white font-mono text-xs text-center font-bold">
            ✓ RESERVATION CONFIRMED // CONFIRMATION EMAIL SENT
          </div>
          <button
            type="button"
            data-modal-dispatch
            class="w-full py-3 bg-[#ff5a00] hover:bg-[#ffffff] text-black font-mono text-xs font-extrabold uppercase tracking-widest transition-colors flex items-center justify-center gap-2"
          >
            <span data-dispatch-label>[CONFIRM RESERVATION]</span>
          </button>
        </div>
      </div>
    </div>

    {/* Modal Bottom Coordinates */}
    <div class="flex flex-col sm:flex-row items-center justify-between pt-3 border-t border-[#222] font-mono text-[10px] text-[#777] gap-2">
      <span>KINETIC CAR RENTAL // BOOKING PORTAL</span>
      <span>FREE CANCELLATION UP TO 24H BEFORE PICKUP</span>
    </div>
  </div>
</div>

<style is:global>
  .option-active {
    background-color: #1e1e1e !important;
    border-color: rgba(255, 90, 0, 0.7) !important;
  }
  .dot-active {
    background-color: #ff5a00 !important;
    box-shadow: 0 0 6px #ff5a00 !important;
  }
</style>

<script>
  import { HUBS, VEHICLES } from '../data/fleetData';

  const modal = document.querySelector<HTMLElement>('[data-modal]');
  const closeBtn = modal?.querySelector<HTMLElement>('[data-modal-close]');
  const hubOptions = Array.from(document.querySelectorAll<HTMLElement>('[data-hub-option]'));
  const vehicleOptions = Array.from(document.querySelectorAll<HTMLElement>('[data-vehicle-option]'));
  const durationInput = document.querySelector<HTMLInputElement>('[data-duration]');
  const durationLabel = document.querySelector<HTMLElement>('[data-duration-label]');
  const estimateEl = document.querySelector<HTMLElement>('[data-estimate]');
  const latencyEl = document.querySelector<HTMLElement>('[data-latency]');
  const dispatchBtn = document.querySelector<HTMLButtonElement>('[data-modal-dispatch]');
  const dispatchLabel = document.querySelector<HTMLElement>('[data-dispatch-label]');
  const successEl = document.querySelector<HTMLElement>('[data-dispatch-success]');

  let selectedHub = 'nyc';
  let selectedVehicle = 'KC-VLK-01';
  let durationDays = 3;
  let dispatching = false;
  let lastFocused: HTMLElement | null = null;

  const isOpen = () => !!modal && !modal.classList.contains('hidden');

  const getFocusable = () =>
    Array.from(
      modal?.querySelectorAll<HTMLElement>(
        'button:not([disabled]), [href], input:not([disabled]), [tabindex]:not([tabindex="-1"])',
      ) ?? [],
    );

  const render = () => {
    const vehicle = VEHICLES.find((v) => v.id === selectedVehicle) ?? VEHICLES[0];
    const hub = HUBS.find((h) => h.id === selectedHub) ?? HUBS[0];
    if (estimateEl) estimateEl.textContent = `$${(vehicle.pricePer24h * durationDays).toLocaleString()} TOTAL`;
    if (latencyEl) latencyEl.textContent = `IMMEDIATE (${hub.latency})`;
    if (durationLabel) durationLabel.textContent = `${durationDays} DAYS`;
  };

  const selectHub = (id: string) => {
    selectedHub = id;
    hubOptions.forEach((opt) => {
      const active = opt.getAttribute('data-hub-option') === id;
      opt.classList.toggle('option-active', active);
      opt.querySelector('[data-hub-dot]')?.classList.toggle('dot-active', active);
    });
    render();
  };

  const selectVehicle = (id: string) => {
    selectedVehicle = id;
    vehicleOptions.forEach((opt) => {
      const active = opt.getAttribute('data-vehicle-option') === id;
      opt.classList.toggle('option-active', active);
      opt.querySelector('[data-vehicle-dot]')?.classList.toggle('dot-active', active);
    });
    render();
  };

  if (modal) {
    hubOptions.forEach((opt) => {
      opt.addEventListener('click', () => selectHub(opt.getAttribute('data-hub-option') ?? 'nyc'));
      opt.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          selectHub(opt.getAttribute('data-hub-option') ?? 'nyc');
        }
      });
    });
    vehicleOptions.forEach((opt) => {
      opt.addEventListener('click', () => selectVehicle(opt.getAttribute('data-vehicle-option') ?? 'KC-VLK-01'));
      opt.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          selectVehicle(opt.getAttribute('data-vehicle-option') ?? 'KC-VLK-01');
        }
      });
    });
    durationInput?.addEventListener('input', (e) => {
      durationDays = Number((e.target as HTMLInputElement).value);
      render();
    });

    dispatchBtn?.addEventListener('click', () => {
      if (dispatching) return;
      dispatching = true;
      dispatchBtn.disabled = true;
      if (dispatchLabel) dispatchLabel.textContent = 'PROCESSING YOUR BOOKING...';
      setTimeout(() => {
        dispatching = false;
        successEl?.classList.remove('hidden');
        dispatchBtn.classList.add('hidden');
        setTimeout(() => {
          successEl?.classList.add('hidden');
          dispatchBtn.disabled = false;
          dispatchBtn.classList.remove('hidden');
          if (dispatchLabel) dispatchLabel.textContent = '[CONFIRM RESERVATION]';
          closeModal();
        }, 2500);
      }, 1200);
    });
  }

  const openModal = (vehicleId?: string) => {
    if (!modal) return;
    lastFocused = document.activeElement as HTMLElement | null;
    if (vehicleId) selectVehicle(vehicleId);
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(() => closeBtn?.focus());
  };
  const closeModal = () => {
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
    lastFocused?.focus();
    lastFocused = null;
  };

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const opener = target.closest('[data-open-modal]');
    if (opener) {
      openModal(opener.getAttribute('data-vehicle') ?? undefined);
      return;
    }
    if (target.closest('[data-modal-close]')) {
      closeModal();
      return;
    }
    if (target === modal) {
      closeModal();
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen()) {
      closeModal();
      return;
    }
    if (e.key === 'Enter' || e.key === ' ') {
      const opener = (e.target as HTMLElement)?.closest?.('[data-open-modal]') as HTMLElement | null;
      if (opener) {
        e.preventDefault();
        openModal(opener.getAttribute('data-vehicle') ?? undefined);
        return;
      }
    }
    if (e.key === 'Tab' && isOpen() && modal) {
      const focusable = getFocusable();
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      const active = document.activeElement as HTMLElement | null;
      if (e.shiftKey && (active === first || !modal.contains(active))) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && (active === last || !modal.contains(active))) {
        e.preventDefault();
        first.focus();
      }
    }
  });

  // Initialize hub/vehicle selections
  selectHub('nyc');
  selectVehicle('KC-VLK-01');
  render();
</script>