---
import OrbitCarousel from './ui/orbiting-carousel-with-animated-icons';
---

<section class="relative w-full bg-[#0e0e0e] border-b border-[#1f1f1f] scroll-mt-12" id="sales-team">
  {/* Ambient Glass Backlight Layer */}
  <div
    class="absolute inset-x-0 top-0 bottom-0 pointer-events-none"
    style="background: radial-gradient(900px circle at 80% 5%, rgba(255,90,0,0.20), transparent 55%), radial-gradient(700px circle at 12% 90%, rgba(255,90,0,0.12), transparent 60%)"
  />
  <div class="relative max-w-[1200px] mx-auto px-4 sm:px-5 lg:px-6 py-10 sm:py-14 lg:py-16">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 pb-4 border-b border-[#1f1f1f]">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <span class="w-2 h-2 bg-[#ff5a00] inline-block shadow-[0_0_6px_#ff5a00]"></span>
          <span class="font-mono text-[10px] uppercase tracking-widest text-[#ff5a00]">[MODULE_04 // SALES TEAM]</span>
        </div>
        <h2 class="font-headline text-xl sm:text-2xl lg:text-3xl font-extrabold uppercase tracking-tight text-[#ffffff] m-0">
          TALK TO A HUMAN
        </h2>
      </div>
      <div class="text-left md:text-right font-mono text-[10px] sm:text-xs text-[#888] uppercase tracking-wider mt-4 md:mt-0">
        6 SPECIALISTS // 5 CITIES
        <br class="hidden md:block" />
        DIRECT LINE // NO CALL CENTERS
      </div>
    </div>

    {/* Below the fold and carries no critical content, so it hydrates on
        approach rather than competing with the hero for the main thread. */}
    <OrbitCarousel client:visible />
  </div>
</section>
