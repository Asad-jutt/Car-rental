---
import { DRIVER_LOGS } from '../data/fleetData';
---

<section class="relative w-full bg-[#0e0e0e] border-b border-[#1f1f1f] scroll-mt-12" id="case-studies">
  {/* Ambient Glass Backlight Layer */}
  <div
    class="absolute inset-x-0 top-0 bottom-0 pointer-events-none"
    style="background: radial-gradient(900px circle at 80% 5%, rgba(255,90,0,0.20), transparent 55%), radial-gradient(700px circle at 12% 90%, rgba(255,90,0,0.12), transparent 60%)"
  />
  <div class="relative max-w-[1200px] mx-auto px-4 sm:px-5 lg:px-6 py-10 sm:py-14 lg:py-16">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 pb-4 border-b border-[#1f1f1f]">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <span class="w-2 h-2 bg-[#ff5a00] inline-block shadow-[0_0_6px_#ff5a00]"></span>
          <span class="font-mono text-[10px] uppercase tracking-widest text-[#ff5a00]">[MODULE_04 // CUSTOMER REVIEWS]</span>
        </div>
        <h2 class="font-headline text-xl sm:text-2xl lg:text-3xl font-extrabold uppercase tracking-tight text-[#ffffff] m-0">
          WHAT OUR DRIVERS SAY
        </h2>
      </div>
      <div class="text-left md:text-right font-mono text-[10px] sm:text-xs text-[#888] uppercase tracking-wider mt-4 md:mt-0">
        VERIFIED ORDERS // 4.9/5 AVERAGE RATING
      </div>
    </div>

    {/* Editorial High-Contrast Testimonial Grid */}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-0 overflow-hidden border border-[#1f1f1f] divide-y lg:divide-y-0 lg:divide-x divide-[#1f1f1f]">
      {DRIVER_LOGS.map((log) => (
        <div
          class="p-5 sm:p-6 bg-[#0e0e0e] flex flex-col justify-between hover:bg-[#121212] transition-colors"
        >
          <div>
            <div class="flex items-center justify-between gap-1 flex-wrap pb-3 border-b border-[#1f1f1f] mb-4">
              <span class="font-mono text-[10px] text-[#ff5a00] font-bold">{log.dispatchHash}</span>
              <span class="font-mono text-[10px] text-[#888]">{log.node}</span>
            </div>
          </div>
          <figure class="m-0 flex flex-col justify-between flex-1">
            <blockquote class="font-editorial text-[13px] sm:text-sm text-[#e2e2e2] leading-relaxed mb-6 italic">
              {log.quote}
            </blockquote>
            <figcaption class="space-y-1.5 pt-4 border-t border-[#1f1f1f]">
              <h3 class="font-headline text-sm font-bold uppercase text-[#ffffff]">{log.author}</h3>
              <div class="font-mono text-[10px] text-[#888] uppercase tracking-wider">{log.title}</div>
              <div class="grid grid-cols-2 gap-2.5 mt-4 bg-[#161616] p-2.5 border border-[#222] font-mono text-[10px]">
                <span class="text-[#888]">{log.stat1Label} <span class="text-[#ff5a00] font-bold">{log.stat1Val}</span></span>
                <span class="text-[#888]">{log.stat2Label} <span class="text-[#ffffff] font-bold">{log.stat2Val}</span></span>
              </div>
            </figcaption>
          </figure>
        </div>
      ))}
    </div>
  </div>
</section>