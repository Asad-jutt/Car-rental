---
import CarParticleCanvas from '../components/ui/car-particle-canvas';
---

<div
  id="hero"
  class="group relative w-full min-h-[calc(100vh-3rem)] supports-[height:100svh]:min-h-[calc(100svh-3rem)] flex flex-col overflow-hidden bg-[#0e0e0e] select-none border-b border-[#1f1f1f]"
>
  {/* INTERACTIVE PARTICLE SILHOUETTE // HOVER TO DISPERSE */}
  <div class="absolute inset-0 z-0">
    <CarParticleCanvas
      client:only="react"
      src="/hero-car.webp"
      className="absolute inset-0 h-full w-full"
      color="#e8e8e8"
      particleSize={1.5}
      radius={0.2}
      strength={1500}
      spring={5.5}
      damping={0.9}
      depth={0.25}
      idle={0.12}
      opacity={1}
    />
    {/* Legibility Overlay Gradients */}
    <div class="absolute inset-0 bg-gradient-to-r from-[#0e0e0e]/35 via-transparent to-[#0e0e0e]/45 pointer-events-none" />
    <div class="absolute inset-0 bg-gradient-to-t from-[#0e0e0e]/80 via-[#0e0e0e]/15 to-[#0e0e0e]/50 pointer-events-none" />
  </div>

  {/* Left Vertical Micro-Running Axis Tracker */}
  <div class="hidden md:flex absolute left-0 top-0 bottom-0 z-10 w-10 sm:w-12 flex-col items-center justify-between py-6 bg-[#0e0e0e]/70 backdrop-blur-sm border-r border-[#1f1f1f]/80 xl:justify-center" aria-hidden="true">
    
    <div class="[writing-mode:vertical-rl] rotate-180 font-mono text-[9px] tracking-[0.25em] text-[#888] uppercase">
      [KINETIC CAR RENTAL] // PICK_UP & DRIVE
    </div>
    <div class="flex flex-col items-center gap-1">
    </div>
  </div>

  {/* Blueprint Vignette & Corner Bracket Overlays */}
  <div class="absolute top-4 sm:top-6 left-4 md:left-14 z-10 pointer-events-none flex items-center gap-2">
    <span class="font-mono text-[10px] text-[#e2e2e2] tracking-widest uppercase">BRANCH: NYC</span>
  </div>
  <div class="absolute top-4 sm:top-6 right-4 sm:right-6 z-10 pointer-events-none text-right">
    <span class="font-mono text-[10px] text-[#888] uppercase">OPEN 24/7<span class="hidden sm:inline"> // AIRPORT PICKUP</span></span>
    <span class="font-mono text-xs text-[#ff5a00] font-bold block" aria-hidden="true">┐</span>
  </div>
  <div class="absolute bottom-4 sm:bottom-6 left-4 md:left-14 z-10 pointer-events-none">
    <span class="font-mono text-xs text-[#ff5a00] font-bold" aria-hidden="true">└</span>
  </div>
  <div class="absolute bottom-4 sm:bottom-6 right-4 sm:right-6 z-10 pointer-events-none">
    <span class="font-mono text-xs text-[#ff5a00] font-bold" aria-hidden="true">┘</span>
  </div>

  {/* Centered Hero Content Overlay */}
  <div class="relative z-10 flex-1 w-full flex flex-col items-center justify-start text-center px-4 sm:px-8 lg:px-16 pt-28 sm:pt-36 lg:pt-44 pb-10 pointer-events-none">
    {/* Top Metadata Label */}
    <span class="mb-4 sm:mb-6 px-2 py-0.5 bg-[#ff5a00] text-black font-mono text-[9px] sm:text-[10px] font-bold tracking-widest uppercase rounded-sm">
      Premium car rental
    </span>

    {/* Typographic Headline */}
    <h1 class="font-headline text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-black text-[#ffffff] uppercase tracking-tight leading-[1.05] m-0 max-w-4xl">
      Rent without
      <br />
      <span class="text-[#ff5a00]">the runaround.</span>
    </h1>

    {/* Editorial Sub-Statement. Reads as brand copy, but does the entity work:
        the first paragraph a crawler sees now names the service category and
        every collection city, which the H1 deliberately does not. */}
    <p class="font-editorial text-xs sm:text-sm text-[#b3b3b3] leading-relaxed max-w-md mt-5 sm:mt-6">
      Premium car rental in New York, London, San Francisco, Chicago and Miami.
      Transparent daily rates, insurance included, 24/7 roadside support.
    </p>

    {/* Telemetry Strip */}
    <div class="hidden sm:flex items-center mt-6 sm:mt-8 border border-[#2e2e2e] bg-[#141414]/50 backdrop-blur-xl divide-x divide-[#2e2e2e]">
      <span class="px-3 py-1.5 font-mono text-[10px] text-[#7a7a7a] uppercase tracking-widest">
        Local
        <span id="live-clock" data-local-clock class="ml-1.5 text-[#e2e2e2] font-bold tabular-nums tracking-wider">
          --:--:--
        </span>
      </span>
      <span class="px-3 py-1.5 font-mono text-[10px] text-[#7a7a7a] uppercase tracking-widest">
        Fleet
        <span class="ml-1.5 text-[#ff5a00] font-bold">12 ready</span>
      </span>
    </div>

    {/* Run Engine Action */}
    <a
      href="/booking"
      class="pointer-events-auto group mt-6 sm:mt-8 inline-flex items-center gap-2 px-4 py-2 bg-[#ff5a00] hover:bg-[#ffffff] text-black transition-colors cursor-pointer shrink-0"
    >
      <span class="font-mono text-[11px] font-extrabold uppercase tracking-[0.15em]">Reserve now</span>
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5"
        aria-hidden="true"
      >
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    </a>
    <span class="font-mono text-[9px] text-[#7a7a7a] uppercase tracking-widest mt-3 sm:mt-3.5">
      Free cancellation up to 24h before pickup
    </span>
  </div>
</div>

<script>
  const clock = document.querySelector('[data-local-clock]');
  const pad = (n: number) => String(n).padStart(2, '0');
  let timer = 0;

  const update = () => {
    if (!clock) return;
    const now = new Date();
    clock.textContent = `${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}`;
  };

  // Only render the clock while the hero is on screen: a one-second timer
  // ticking over an off-screen readout is pure wasted work, and on a
  // client-side navigation an un-cleared interval would stack up.
  const start = () => {
    if (timer) return;
    update();
    // Aim at the next whole second so the digits do not visibly stutter.
    const delay = 1000 - (Date.now() % 1000);
    timer = window.setTimeout(function tick() {
      update();
      timer = window.setTimeout(tick, 1000);
    }, delay);
  };

  const stop = () => {
    if (!timer) return;
    window.clearTimeout(timer);
    timer = 0;
  };

  start();

  const observer = new IntersectionObserver(
    ([entry]) => (entry?.isIntersecting ? start() : stop()),
  );
  if (clock) observer.observe(clock);

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) stop();
    else start();
  });
  // Astro's view transitions swap the page without a reload, so tear the timer
  // down when this page is discarded.
  document.addEventListener('astro:before-swap', stop);
</script>