---
import CarParticleCanvas from '../components/ui/car-particle-canvas';
---

<div
  id="hero"
  class="group relative w-full min-h-screen supports-[height:100svh]:min-h-[100svh] flex flex-col overflow-hidden bg-[#0e0e0e] select-none border-b border-[#1f1f1f]"
>
  {/* INTERACTIVE PARTICLE SILHOUETTE // HOVER TO DISPERSE */}
  <div class="absolute inset-0 z-0">
    <CarParticleCanvas
      client:only="react"
      src="/hero-car.webp"
      className="absolute inset-0 h-full w-full"
      color="#e8e8e8"
      particleSize={1.5}
      radius={0.12}
      strength={180}
      spring={5}
      damping={0.93}
      depth={0.25}
      idle={0.12}
      opacity={1}
    />
    {/* Legibility Overlay Gradients */}
    <div class="absolute inset-0 bg-gradient-to-r from-[#0e0e0e]/35 via-transparent to-[#0e0e0e]/45 pointer-events-none" />
    <div class="absolute inset-0 bg-gradient-to-t from-[#0e0e0e]/80 via-[#0e0e0e]/15 to-[#0e0e0e]/50 pointer-events-none" />
  </div>

  {/* Left Vertical Micro-Running Axis Tracker */}
  <div class="hidden md:flex absolute left-0 top-0 bottom-0 z-10 w-10 sm:w-12 flex-col items-center justify-between py-6 bg-[#0e0e0e]/70 backdrop-blur-sm border-r border-[#1f1f1f]/80">
    
    <div class="[writing-mode:vertical-rl] rotate-180 font-mono text-[9px] tracking-[0.25em] text-[#888] uppercase">
      [KINETIC CAR RENTAL] // PICK_UP & DRIVE
    </div>
    <div class="flex flex-col items-center gap-1">
      <span class="w-1.5 h-1.5 bg-[#ff5a00]"></span>
      <span class="font-mono text-[10px] text-[#888]">01</span>
    </div>
  </div>

  {/* Blueprint Vignette & Corner Bracket Overlays */}
  <div class="absolute top-4 sm:top-6 left-4 md:left-14 z-10 pointer-events-none flex items-center gap-2">
    <span class="font-mono text-[10px] text-[#e2e2e2] tracking-widest uppercase">BRANCH: NYC</span>
  </div>
  <div class="absolute top-4 sm:top-6 right-4 sm:right-6 z-10 pointer-events-none text-right">
    <span class="font-mono text-[10px] text-[#888] uppercase">OPEN 24/7<span class="hidden sm:inline"> // AIRPORT PICKUP</span></span>
    <span class="font-mono text-xs text-[#ff5a00] font-bold block">┐</span>
  </div>
  <div class="absolute bottom-4 sm:bottom-6 left-4 md:left-14 z-10 pointer-events-none">
    <span class="font-mono text-xs text-[#ff5a00] font-bold">└</span>
  </div>
  <div class="absolute bottom-4 sm:bottom-6 right-4 sm:right-6 z-10 pointer-events-none">
    <span class="font-mono text-xs text-[#ff5a00] font-bold">┘</span>
  </div>

  {/* Centered Hero Content Overlay */}
  <div class="relative z-10 flex-1 w-full flex flex-col items-center justify-center text-center px-4 sm:px-8 lg:px-16 py-10 lg:py-0 pointer-events-none">
    {/* Top Metadata Header */}
    <div class="flex items-center gap-2 flex-wrap justify-center mb-4">
      <span class="px-1.5 py-0.5 bg-[#ff5a00] text-black font-mono text-[10px] font-bold tracking-wider uppercase rounded-md">
        PREMIUM CAR RENTAL
      </span>
      <span class="font-mono text-[10px] text-[#929292] tracking-widest uppercase">
        [KINETIC RENTAL GROUP]
      </span>
    </div>

    {/* Massive Typographic Headline // MIDDLE */}
    <h1 class="font-headline text-2xl sm:text-4xl lg:text-5xl xl:text-6xl font-black text-[#ffffff] uppercase tracking-tight leading-[1.08] lg:leading-[0.92] xl:leading-[1.08] m-0 max-w-6xl">
      RENT
      <br />
      WITHOUT
      <br />
      <span class="text-[#ff5a00]">THE RUNAROUND.</span>
    </h1>

    {/* Editorial Sub-Statement */}
    <p class="font-editorial text-[13px] sm:text-sm text-[#ccc] leading-relaxed max-w-3xl mt-4">
      Book a car online in minutes and pick it up at any branch. Transparent daily rates, included insurance, and 24/7 roadside support on every trip.
    </p>

    {/* Industrial Telemetry Widgets Array */}
    <div class="hidden sm:grid w-full max-w-3xl grid-cols-3 gap-2 sm:gap-3 mt-6">
      <div class="p-2.5 sm:p-3 bg-[#1f1f1f]/30 backdrop-blur-xl border border-[#333]/60 flex flex-col text-left">
        <span class="font-mono text-[9px] text-[#888] uppercase">[LOCAL TIME]</span>
        <span id="live-clock" data-local-clock class="font-mono text-[11px] sm:text-xs text-[#ffffff] mt-0.5 font-bold tabular-nums tracking-wider">
          --:--:--
        </span>
      </div>
      <div class="p-2.5 sm:p-3 bg-[#1f1f1f]/30 backdrop-blur-xl border border-[#333]/60 flex flex-col text-left">
        <span class="font-mono text-[9px] text-[#888] uppercase">[RENTAL TYPE]</span>
        <span class="font-mono text-[11px] sm:text-xs text-[#ffffff] mt-0.5 font-bold tracking-tight truncate">DAILY · WEEKEND · MONTHLY</span>
      </div>
      <div class="p-2.5 sm:p-3 bg-[#1f1f1f]/30 backdrop-blur-xl border border-[#333]/60 flex flex-col text-left">
        <span class="font-mono text-[9px] text-[#888] uppercase">[FLEET STATUS]</span>
        <span class="font-mono text-[11px] sm:text-xs text-[#ff5a00] mt-0.5 font-bold tracking-tight">12 CARS READY</span>
      </div>
    </div>

    {/* Run Engine Action */}
    <div
      data-open-modal
      role="button"
      tabindex="0"
      class="pointer-events-auto mt-6 inline-flex items-center justify-between gap-3 sm:gap-5 px-7 sm:px-9 py-3 bg-[#ff5a00] hover:bg-[#ffffff] transition-colors cursor-pointer group shrink-0"
    >
      <div class="flex flex-col items-start min-w-0">
        <span class="font-mono text-[10px] text-black font-bold uppercase tracking-widest">[BOOK]</span>
        <span class="font-headline text-base sm:text-lg text-black font-black uppercase tracking-tight leading-tight whitespace-nowrap">RESERVE NOW →</span>
      </div>
      <div class="hidden lg:flex shrink-0 whitespace-nowrap items-center gap-1.5 bg-black/15 px-2 py-0.5">
        <span class="font-mono text-[10px] text-black font-bold tracking-widest uppercase">FREE CANCELLATION</span>
        <span class="material-symbols-outlined text-black text-sm">calendar_today</span>
      </div>
    </div>
  </div>
</div>

<script>
  const clock = document.querySelector('[data-local-clock]');
  const pad = (n: number) => String(n).padStart(2, '0');
  const update = () => {
    if (!clock) return;
    const now = new Date();
    clock.textContent = `${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}`;
  };
  update();
  setInterval(update, 1000);
</script>