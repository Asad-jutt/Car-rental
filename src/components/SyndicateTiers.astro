---
import { SYNDICATE_TIERS } from '../data/fleetData';
---

<section class="w-full bg-[#0e0e0e] border-b border-[#1f1f1f] scroll-mt-12" id="tiers">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-5 lg:px-6 py-10 sm:py-14 lg:py-16">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 pb-4 border-b border-[#1f1f1f]">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <span class="w-2 h-2 bg-[#ff5a00] inline-block shadow-[0_0_6px_#ff5a00]"></span>
          <span class="font-mono text-[10px] uppercase tracking-widest text-[#ff5a00]">[MODULE_03 // PRICING PLANS]</span>
        </div>
        <h2 class="font-headline text-xl sm:text-2xl lg:text-3xl font-extrabold uppercase tracking-tight text-[#ffffff] m-0">
          SIMPLE RENTAL PLANS
        </h2>
        <p class="font-mono text-[10px] sm:text-[11px] text-[#929292] uppercase tracking-widest mt-1.5">
          FLEXIBLE DAILY, WEEKEND &amp; MONTHLY OPTIONS — CANCEL ANYTIME
        </p>
      </div>
      <div class="font-mono text-[10px] sm:text-xs text-[#888] uppercase tracking-wider mt-4 md:mt-0">
        [ALL PLANS INCLUDE BASIC INSURANCE &amp; ROADSIDE ASSISTANCE]
      </div>
    </div>

    {/* 3 Bordered Data Columns */}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-px overflow-hidden bg-[#1f1f1f] border border-[#1f1f1f]">
      {SYNDICATE_TIERS.map((tier) => (
        <div
          class={`p-5 sm:p-6 flex flex-col justify-between group transition-colors relative ${
            tier.featured
              ? 'bg-[#141414] border-2 border-[#ff5a00]'
              : 'bg-[#0e0e0e] hover:bg-[#141414]'
          }`}
        >
          {/* Floating Corner Badge for featured */}
          {tier.featured && (
            <div class="absolute top-1.5 right-1.5 bg-[#ff5a00] text-black font-mono text-[10px] font-bold uppercase px-3 py-1 tracking-wider">
              {tier.slotsRemaining}
            </div>
          )}

          <div>
            <div class="flex items-center justify-between gap-1 flex-wrap mb-5 pb-3 border-b border-[#1f1f1f]">
              <span class={`font-mono text-[10px] uppercase ${tier.featured ? 'text-[#ff5a00] font-bold' : 'text-[#888]'}`}>
                {tier.tierNumber}
              </span>
              <span class="font-mono text-[10px] uppercase text-[#aaa]">{tier.statusBadge}</span>
            </div>

            <h3 class="font-headline text-base sm:text-lg font-bold uppercase text-[#ffffff] tracking-tight mb-2.5">{tier.name}</h3>

            <div class="flex items-baseline gap-2 mb-4">
              <span class={`font-headline text-xl sm:text-2xl font-extrabold ${tier.featured ? 'text-[#ff5a00]' : 'text-[#ffffff]'}`}>
                {tier.price}
              </span>
              <span class="font-mono text-[10px] text-[#888] uppercase">{tier.priceSub}</span>
            </div>

            <ul class="space-y-2.5 font-editorial text-xs sm:text-[13px] text-[#b0b0b0] border-t border-[#1f1f1f] pt-4 mb-6">
              {tier.features.map((feat) => (
                <li class="flex items-start gap-2.5">
                  <span class={`font-mono font-bold text-xs ${feat.included ? 'text-[#ff5a00]' : 'text-[#555]'}`}>
                    {feat.included ? '✛' : '—'}
                  </span>
                  <span class={feat.included ? 'text-[#d0d0d0]' : 'text-[#666] line-through'}>{feat.text}</span>
                </li>
              ))}
            </ul>
          </div>

          <a
            href="/booking"
            class={`w-full inline-block text-center py-2.5 font-mono text-xs uppercase tracking-wider font-bold transition-colors ${
              tier.featured
                ? 'bg-[#ff5a00] hover:bg-[#ffffff] text-black'
                : 'bg-[#202020] hover:bg-[#ff5a00] text-[#ffffff] hover:text-black border border-[#333]'
            }`}
          >
            {tier.buttonText}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>