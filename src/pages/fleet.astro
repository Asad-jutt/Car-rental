---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import CtaSection from '../components/CtaSection.astro';
import Footer from '../components/Footer.astro';
import CardsRotateSlider from '../components/ui/cards-rotate-slider';
import { getCars, wheelAnglesFor, sizedImage, ASPECT } from '../lib/cms';
import { fleetListSchema, breadcrumbSchema } from '../lib/schema';
import { carPath, carTitle, carCategoryLabel } from '../lib/vehicle-meta';

const CARS = await getCars();

// One card per listed vehicle. This previously asked for seven exterior angles
// per car off the CMS gallery, which put 70 cards on the wheel for 10 cars —
// seven ScrollTriggers each, and a page that read as a slideshow of angles
// rather than a fleet. The wheel is a fleet index, so it shows the fleet.
const SLIDES = CARS.map((vehicle) => {
  const [src] = wheelAnglesFor(vehicle, 1);
  return {
    src: sizedImage(src ?? vehicle.imageUrl, ASPECT.wheelCard),
    text: vehicle.name,
    sub: `[${vehicle.band} // ${vehicle.category.toUpperCase()}]`,
    spec: `${vehicle.power}${vehicle.powerUnit} / ${vehicle.zeroToSixty}S / ${vehicle.drive}`,
    price: `$${vehicle.pricePer24h}`,
    vehicleId: vehicle.id,
  };
});
---

<BaseLayout
  title="Rental Fleet Index — EVs, Sports Coupes & SUVs | KINETIC"
  description={`Browse every car available from KINETIC: electric vehicles, sports coupes and family SUVs from $109/day. Full specs, daily rates and collection hubs for all ${CARS.length} vehicles.`}
  schema={[
    fleetListSchema(CARS),
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Fleet', path: '/fleet/' },
    ]),
  ]}
>
  <Header />

  <main class="w-full pt-12 flex-1 flex flex-col">
    {/* Module 00 — Page Intro */}
    <section class="relative w-full bg-[#0e0e0e] border-b border-[#1f1f1f]">
      <div
        class="absolute inset-0 pointer-events-none"
        style="background: radial-gradient(900px circle at 78% 20%, rgba(255,90,0,0.18), transparent 55%), radial-gradient(700px circle at 10% 90%, rgba(255,90,0,0.10), transparent 60%)"
      />
      <div class="relative max-w-[1200px] mx-auto px-4 sm:px-5 lg:px-6 py-10 sm:py-14">
        <div class="font-mono text-[10px] text-[#777] uppercase tracking-widest mb-6">
          <a href="/" class="inline-flex items-center gap-1.5 text-[#a0a0a0] hover:text-[#ff5a00] transition-colors">
            <span aria-hidden>←</span> BACK TO HOMEPAGE
          </a>
        </div>

        <div class="flex flex-col xl:flex-row xl:items-end justify-between gap-4 mb-8 pb-4 border-b border-[#1f1f1f]">
          <div>
            <div class="flex items-center gap-2 mb-2">
              <span class="w-2 h-2 bg-[#ff5a00] inline-block shadow-[0_0_6px_#ff5a00]"></span>
              <span class="font-mono text-[10px] uppercase tracking-widest text-[#ff5a00]">[MODULE_00 // FLEET INDEX]</span>
            </div>
            <h1 class="font-headline text-2xl sm:text-3xl lg:text-4xl font-black uppercase tracking-tight text-[#ffffff] m-0">
              THE FLEET<span class="text-[#ff5a00]">.</span>
            </h1>
            <p class="font-mono text-[10px] sm:text-[11px] text-[#929292] uppercase tracking-widest mt-1.5">
              ROTATE THE WHEEL // SETTLE ON A CAR // BOOK IMMEDIATELY
            </p>
          </div>
          <div class="text-left xl:text-right font-mono text-[10px] sm:text-xs text-[#888] uppercase tracking-wider">
            {SLIDES.length} SLOTS ONLINE
            <br />
            RATES INCLUDE BASIC INSURANCE + ROADSIDE 24/7
          </div>
        </div>
      </div>
    </section>

    {/* Rotating Wheel Slider */}
    <CardsRotateSlider
      client:load
      images={SLIDES}
      rotationAmount={1.1}
      verticalDrift={1.2}
      perspective={1100}
      textColor="#f2f2f2"
    />

    {/* Static, crawlable fleet index.
        The rotating wheel above is a JS carousel: it renders server-side, but it
        is a browsing affordance, not a link graph. Without this section the ten
        per-vehicle pages had no inbound internal link from /fleet, which is the
        strongest topical signal available for them. This is plain server-rendered
        markup - no hydration - so it is in the HTML a crawler and a retrieval
        engine both read. */}
    <section class="w-full bg-[#0e0e0e] border-t border-[#1f1f1f]">
      <div class="w-full max-w-[1200px] mx-auto px-4 sm:px-5 lg:px-6 py-12 sm:py-16">
        <h2 class="font-headline text-xl sm:text-2xl lg:text-3xl font-extrabold uppercase tracking-tight text-[#ffffff] m-0">
          Every vehicle, with specs
        </h2>
        <p class="font-mono text-[10px] sm:text-[11px] uppercase tracking-widest text-[#929292] mt-1.5 mb-0">
          {CARS.length} VEHICLES // RATES PER 24 HOURS // INSURANCE INCLUDED
        </p>

        <ul class="list-none p-0 m-0 mt-7 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {
            CARS.map((car) => (
              <li class="border border-[#222] bg-[#141414]">
                <a
                  href={carPath(car)}
                  class="block p-4 hover:border-[#ff5a00] transition-colors"
                >
                  <h3 class="font-headline text-base sm:text-lg font-bold uppercase tracking-tight text-[#ffffff] m-0">
                    {carTitle(car)}
                  </h3>
                  <p class="font-mono text-[10px] uppercase tracking-wider text-[#777] mt-1 mb-3">
                    {carCategoryLabel(car)} // {car.name}
                  </p>
                  <dl class="font-mono text-[11px] text-[#b0b0b0] m-0 grid grid-cols-2 gap-x-3 gap-y-1">
                    <dt class="text-[#777]">POWER</dt>
                    <dd class="m-0 text-right tabular-nums">
                      {car.power} {car.powerUnit}
                    </dd>
                    <dt class="text-[#777]">0-60 MPH</dt>
                    <dd class="m-0 text-right tabular-nums">{car.zeroToSixty}S</dd>
                    <dt class="text-[#777]">SEATS</dt>
                    <dd class="m-0 text-right tabular-nums">{car.seats}</dd>
                    <dt class="text-[#777]">RATE</dt>
                    <dd class="m-0 text-right tabular-nums text-[#ff5a00]">${car.pricePer24h}/DAY</dd>
                  </dl>
                  <p class="font-mono text-[10px] uppercase tracking-wider mt-3 mb-0 text-[#8a8a8a]">
                    {car.available ? 'Available to book' : 'Between bookings'} · View specs →
                  </p>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <CtaSection />
  </main>

  <Footer />
</BaseLayout>