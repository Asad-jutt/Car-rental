---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
import FleetMatrix from '../components/FleetMatrix.astro';
import BookingSteps from '../components/ui/booking-steps';
import SyndicateTiers from '../components/SyndicateTiers.astro';
import DriverLogs from '../components/DriverLogs.astro';
import SecurityEnclave from '../components/SecurityEnclave.astro';
import CtaSection from '../components/CtaSection.astro';
import Footer from '../components/Footer.astro';
import AllocationModal from '../components/AllocationModal.astro';
---

<BaseLayout>
  {/* Sticky Navigation */}
  <Header />

  {/* Main Content */}
  <main class="w-full pt-12 flex-1 flex flex-col">
    {/* Hero */}
    <HeroSection />

    {/* Fleet & Rates */}
    <FleetMatrix />

    {/* How Booking Works */}
    <BookingSteps client:load />

    {/* Pricing Plans */}
    <SyndicateTiers />

    {/* Customer Reviews */}
    <DriverLogs />

    {/* FAQs & Policies */}
    <SecurityEnclave />

    {/* Call to Action */}
    <CtaSection />
  </main>

  {/* Footer */}
  <Footer />

  {/* Booking Modal */}
  <AllocationModal />
</BaseLayout>