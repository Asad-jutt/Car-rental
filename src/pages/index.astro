---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
import FleetMatrix from '../components/FleetMatrix.astro';
import BookingSteps from '../components/ui/booking-steps';
import SyndicateTiers from '../components/SyndicateTiers.astro';
import SalesTeam from '../components/SalesTeam.astro';
import DriverLogs from '../components/DriverLogs.astro';
import SecurityEnclave from '../components/SecurityEnclave.astro';
import CtaSection from '../components/CtaSection.astro';
import Footer from '../components/Footer.astro';
import AllocationModal from '../components/AllocationModal.astro';
import { getImage } from 'astro:assets';
import step1 from '../assets/booking/step-1-browse.jpg';
import step2 from '../assets/booking/step-2-book.jpg';
import step3 from '../assets/booking/step-3-docs.jpg';
import step4 from '../assets/booking/step-4-drive.jpg';

const BOOKING_WIDTHS = [480, 640, 960, 1280, 1600, 1920];
const bookingStepsMedia = await Promise.all(
  [step1, step2, step3, step4].map(async (src) => {
    const [fallback, avif, webp] = await Promise.all([
      getImage({
        src,
        width: 1600,
        format: 'jpeg',
        quality: 72,
      }),
      getImage({
        src,
        widths: BOOKING_WIDTHS,
        format: 'avif',
        quality: 72,
        fit: 'cover',
      }),
      getImage({
        src,
        widths: BOOKING_WIDTHS,
        format: 'webp',
        quality: 72,
        fit: 'cover',
      }),
    ]);
    return {
      src: fallback.src,
      width: fallback.attributes.width,
      height: fallback.attributes.height,
      sources: [
        { type: 'image/avif', srcset: avif.srcSet.attribute },
        { type: 'image/webp', srcset: webp.srcSet.attribute },
      ],
    };
  }),
);
---

<BaseLayout>
  {/* Sticky Navigation */}
  <Header />

  {/* Main Content */}
  <main class="w-full pt-12 flex-1 flex flex-col">
    {/* Hero */}
    <HeroSection />

    {/* Fleet & Rates */}
    <FleetMatrix />

    {/* How Booking Works */}
    <BookingSteps media={bookingStepsMedia} client:load />

    {/* Pricing Plans */}
    <SyndicateTiers />

    {/* Sales Team */}
    <SalesTeam />

    {/* Customer Reviews */}
    <DriverLogs />

    {/* FAQs & Policies */}
    <SecurityEnclave />

    {/* Call to Action */}
    <CtaSection />
  </main>

  {/* Footer */}
  <Footer />

  {/* Booking Modal */}
  <AllocationModal />
</BaseLayout>