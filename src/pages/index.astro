---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
import FleetMatrix from '../components/FleetMatrix.astro';
import BookingSteps from '../components/ui/booking-steps';
import SyndicateTiers from '../components/SyndicateTiers.astro';
import SalesTeam from '../components/SalesTeam.astro';
import { TestimonialsSection } from '../components/ui/testimonials-with-marquee';
import { FaqAccordion } from '../components/ui/faq-chat-accordion';
import { DRIVER_LOGS, FAQS } from '../data/fleetData';
import Footer from '../components/Footer.astro';
import { getImage } from 'astro:assets';
import step1 from '../assets/booking/step-1-browse.jpg';
import step2 from '../assets/booking/step-2-book.jpg';
import step3 from '../assets/booking/step-3-docs.jpg';
import step4 from '../assets/booking/step-4-drive.jpg';
import { getCars } from '../lib/cms';
import { faqPageSchema, fleetListSchema, offerCatalogSchema, RATE_TIERS } from '../lib/schema';

// The panel is `lg:col-span-7` of a 1200px shell, so the `sizes` below never
// asks for more than ~640 CSS pixels. The old ladder ran to 1920w, which meant
// every image carried four extra AVIF/WebP encodes that no browser could ever
// pick - dead weight in the build and in the repo, and the largest of them were
// 275KB each.
const BOOKING_WIDTHS = [400, 560, 720, 900];
const bookingStepsMedia = await Promise.all(
  [step1, step2, step3, step4].map(async (src) => {
    const [fallback, avif, webp] = await Promise.all([
      getImage({
        src,
        width: 900,
        format: 'jpeg',
        quality: 70,
      }),
      getImage({
        src,
        widths: BOOKING_WIDTHS,
        format: 'avif',
        quality: 60,
        fit: 'cover',
      }),
      getImage({
        src,
        widths: BOOKING_WIDTHS,
        format: 'webp',
        quality: 70,
        fit: 'cover',
      }),
    ]);
    return {
      src: fallback.src,
      width: fallback.attributes.width,
      height: fallback.attributes.height,
      sources: [
        { type: 'image/avif', srcset: avif.srcSet.attribute },
        { type: 'image/webp', srcset: webp.srcSet.attribute },
      ],
    };
  }),
);

const TESTIMONIAL_AVATARS = [
  'https://images.unsplash.com/photo-1494790108377-be9c29b29330?q=80&w=200&h=200&auto=format&fit=crop&crop=face',
  'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?q=80&w=200&h=200&auto=format&fit=crop&crop=face',
  'https://images.unsplash.com/photo-1438761681033-6461ffad8d80?q=80&w=200&h=200&auto=format&fit=crop&crop=face',
];

const testimonials = DRIVER_LOGS.map((log, i) => ({
  text: log.quote,
  author: {
    name: log.author,
    handle: log.title,
    avatar: TESTIMONIAL_AVATARS[i % TESTIMONIAL_AVATARS.length],
  },
}));

/* Structured data for the homepage. Every node is generated from the same
 * arrays the visible sections render (FAQS, getCars(), the rate tiers), so the
 * machine-readable layer cannot drift from the page. */
const cars = await getCars();
---

<BaseLayout
  title="Car Rental in NYC & London — EVs, Sports Cars, SUVs | KINETIC"
  description="Rent EVs, sports coupes and family SUVs by the day, weekend or month from $89/day. Insurance and 24/7 roadside included. Hubs in New York, London, San Francisco, Chicago and Miami."
  schema={[faqPageSchema(FAQS), fleetListSchema(cars), offerCatalogSchema([...RATE_TIERS])]}
>
  {/* Sticky Navigation */}
  <Header />

  {/* Main Content */}
  <main class="w-full pt-12 flex-1 flex flex-col">
    {/* Hero */}
    <HeroSection />

    {/* Fleet & Rates */}
    <FleetMatrix />

    {/* How Booking Works */}
    <BookingSteps media={bookingStepsMedia} client:visible />

    {/* Pricing Plans */}
    <SyndicateTiers />

    {/* Sales Team */}
    <SalesTeam />

    {/* Customer Reviews. Static markup and a CSS marquee, so it is rendered on
        the server with no hydration at all - `client:visible` here shipped
        React plus a 12-card reconciliation pass for content that never changes. */}
    <TestimonialsSection
      title="WHAT OUR DRIVERS SAY"
      description="PASSENGER & FLEET NODE FEEDBACK // VERIFIED AGAINST LIVE BOOKING RECORDS"
      testimonials={testimonials}
    />

    {/* FAQs & Policies */}
    <FaqAccordion
      data={FAQS}
      timestamp="SUPPORT DESK // MEDIAN REPLY 4 MIN"
      client:visible
    />
  </main>

  {/* Footer */}
  <Footer />
</BaseLayout>

<script>
  // Start the testimonials marquee only once its section is on screen.
  //
  // The marquee is a plain CSS animation on server-rendered markup, so there is
  // no React to hydrate here. Toggling a data attribute and letting the
  // play-state live in CSS keeps the hover-pause rule working; the previous
  // `group-hover:` variant and an attribute selector cannot both live on the
  // same property without one silently losing.
  const marquees = document.querySelectorAll('[data-marquee]');
  if (marquees.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.setAttribute('data-marquee', 'in-view');
            observer.unobserve(entry.target);
          }
        }
      },
      // Start a little before the strip's leading edge clears the fold so it is
      // already moving by the time the cards are readable.
      { rootMargin: '0px 0px -15% 0px' },
    );
    for (const marquee of marquees) observer.observe(marquee);
  }
</script>