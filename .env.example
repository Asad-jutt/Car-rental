# --- Site identity (read at BUILD time) -----------------------------------------
# SITE_URL: the production origin, with scheme and NO trailing slash, e.g.
#   SITE_URL="https://kineticcars.com"
# This single value drives canonical tags, Open Graph URLs, the XML sitemap,
# robots.txt, llms.txt and the JSON-LD @id graph. Set it in the deploy
# environment too, otherwise the build falls back to the example.com
# placeholder and ships canonicals Google will ignore.
# Never commit the real value here if you prefer, but .env is gitignored.
SITE_URL="https://kinetic-car-rental.example.com"


# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"


# --- Car listing CMS (Sanity) -------------------------------------------------
# The site renders statically, so listings are fetched from Sanity during the
# build and baked into the HTML. The browser never calls Sanity, so the public
# dataset can stay open and no read token is ever shipped to the client.
#
# With these UNSET, the site still builds: it falls back to the 10 local seed
# cars in src/data/cars.seed.ts. Set them to switch to live CMS content.
#
# PUBLIC_SANITY_PROJECT_ID: from sanity.io/manage -> your project -> Project ID
# PUBLIC_SANITY_DATASET: usually "production"
# PUBLIC_SANITY_API_VERSION: pin this so a Sanity release cannot change results
PUBLIC_SANITY_PROJECT_ID=""
PUBLIC_SANITY_DATASET="production"
PUBLIC_SANITY_API_VERSION="2024-10-01"

# SANITY_API_TOKEN is a WRITE token and is only needed by the one-time seed
# importer (cd sanity && npm run seed). Never expose it as a PUBLIC_ var.
SANITY_API_TOKEN=""
